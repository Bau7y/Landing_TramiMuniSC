# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Bandeja que recibe los mensajes del formulario
CONTACT_TO=tramimuni.sc@gmail.com

# Remitente. onboarding@resend.dev solo entrega al correo dueño de la cuenta de Resend;
# para producción verifique un dominio propio y use p. ej. TramiMuniSC <contacto@su-dominio.cr>
CONTACT_FROM=TramiMuniSC <onboarding@resend.dev>

# Opcionales: cada capa anti-spam se activa solo si existen sus claves
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis (límite de envíos compartido): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
