---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

export const getStaticPaths = (async () => {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({
    params: { slug: servicio.id },
    props: { servicio },
  }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;
const { data } = servicio;
const { Content } = await render(servicio);
---
<BaseLayout titulo={data.nav} descripcion={data.meta_descripcion}>
  <PageHero titulo={data.titulo} subtitulo={data.subtitulo} miga={data.nav} />

  <div class="container page-layout">
    <div class="page-content">
      <article class="intro prose" aria-labelledby="intro-titulo">
        <h2 id="intro-titulo">{data.intro_titulo}</h2>
        <Content />
      </article>

      <section class="lista" aria-labelledby="lista-titulo">
        <h2 id="lista-titulo">{data.lista.titulo}</h2>
        <ul role="list">
          {data.lista.items.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="pasos" aria-labelledby="pasos-titulo">
        <h2 id="pasos-titulo">{data.pasos.titulo}</h2>
        <ol role="list">
          {data.pasos.items.map((paso, i) => (
            <li class="paso">
              <span class="paso__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="page-aside" aria-label="Contacto rápido">
      <div class="aside-card">
        <h2>{data.aside.titulo}</h2>
        <p>{data.aside.texto}</p>
        <a href={`/contacto?tramite=${servicio.id}`} class="btn btn-primary">{data.aside.boton}</a>
        <p class="aside-card__note">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.01" /></svg>
          <span>{data.aside.nota}</span>
        </p>
      </div>
    </aside>
  </div>

  <section class="page-cta" aria-labelledby="cta-titulo">
    <div class="container">
      <h2 id="cta-titulo">{data.cta.titulo}</h2>
      <p>{data.cta.texto}</p>
      <a href={`/contacto?tramite=${servicio.id}`} class="btn btn-primary">{data.cta.boton}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-layout {
    display: grid;
    gap: var(--spacing_lg);
    padding-block: var(--spacing_xl);
  }

  .page-content {
    display: grid;
    gap: var(--spacing_xl);
    min-width: 0;
  }

  .page-content h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    margin-bottom: var(--spacing_sm);
  }

  /* Texto markdown */
  .prose :global(p) {
    max-width: 68ch;
  }

  .prose :global(p + p) {
    margin-top: var(--spacing_sm);
  }

  /* Lista de requisitos */
  .lista {
    padding: var(--spacing_md);
    background: var(--color_bg_card);
    border: 1px solid var(--color_border);
    border-radius: var(--radius_lg);
  }

  .lista ul {
    display: grid;
    gap: 0.6rem;
  }

  .lista li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.8rem 1rem;
    background: var(--color_bg_secondary);
    border-radius: var(--radius_sm);
    line-height: 1.5;
  }

  .lista svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color_primary);
  }

  :global([data-theme="dark"]) .lista svg {
    color: var(--color_primary_light);
  }

  /* Pasos: línea de tiempo vertical */
  .pasos ol {
    display: grid;
  }

  .paso {
    position: relative;
    display: flex;
    gap: var(--spacing_sm);
    align-items: flex-start;
  }

  .paso:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 4px;
    width: 2px;
    background: var(--color_border);
  }

  .paso__num {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius_full);
    background: var(--color_primary);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    position: relative;
  }

  .paso div {
    padding-bottom: var(--spacing_sm);
  }

  .paso h3 {
    font-size: 1.08rem;
    margin-bottom: 0.15rem;
    margin-top: 0.3rem;
  }

  .paso p {
    font-size: 0.95rem;
  }

  /* Aside */
  .aside-card {
    display: grid;
    gap: var(--spacing_xs);
    padding: var(--spacing_md);
    background: var(--color_bg_card);
    border: 1px solid var(--color_border);
    border-radius: var(--radius_lg);
    box-shadow: var(--shadow_sm);
    position: sticky;
    top: calc(var(--navbar_height) + var(--spacing_sm));
  }

  .aside-card h2 {
    font-size: 1.2rem;
  }

  .aside-card p {
    font-size: 0.93rem;
  }

  .aside-card .btn {
    margin-block: var(--spacing_xs);
  }

  .aside-card__note {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.75rem;
    background: var(--color_primary_bg);
    border-radius: var(--radius_sm);
    font-size: 0.84rem !important;
    line-height: 1.5;
  }

  .aside-card__note svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color_primary);
  }

  /* CTA final */
  .page-cta {
    padding-block: var(--spacing_xl);
    text-align: center;
    background: var(--color_bg_secondary);
    border-top: 1px solid var(--color_border);
  }

  .page-cta .container {
    display: grid;
    justify-items: center;
    gap: var(--spacing_xs);
  }

  .page-cta h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
  }

  .page-cta .btn {
    margin-top: var(--spacing_xs);
  }

  @media (min-width: 900px) {
    .page-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
      gap: var(--spacing_xl);
    }
  }
</style>
