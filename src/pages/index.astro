---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BuildingIcon from '../components/BuildingIcon.astro';
import { site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  { title: 'Recepción de la consulta', text: 'El contribuyente nos contacta y se analiza el trámite requerido.' },
  { title: 'Revisión de requisitos', text: 'Se valida la información y documentación necesaria según normativa municipal.' },
  { title: 'Desarrollo del proceso', text: 'Presentación de la documentación del trámite solicitado en la Municipalidad de San Carlos.' },
  { title: 'Seguimiento y cierre', text: 'Se da seguimiento hasta la finalización del trámite o la correcta presentación ante la Municipalidad.' },
];

const benefits = [
  { title: 'Menos errores', text: 'Revisamos requisitos y documentos antes de presentarlos.' },
  { title: 'Sin traslados innecesarios', text: 'Gestionamos la presentación ante la municipalidad por usted.' },
  { title: 'Menos tiempo de espera', text: 'Damos seguimiento al trámite hasta su cierre.' },
];
---
<BaseLayout
  title={site.name}
  description="Acompañamiento en trámites ante la Municipalidad de San Carlos: exoneraciones, declaraciones de bienes inmuebles, consultas y más."
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero_title">
    <div class="container hero_grid">
      <div class="hero_content">
        <span class="section_badge">San Carlos, Costa Rica</span>
        <h1 id="hero_title">Trámites municipales con servicio personalizado</h1>
        <p>
          Facilitamos la gestión de sus trámites ante la Municipalidad de San Carlos
          sin necesidad de desplazarse a las oficinas municipales.
        </p>
        <div class="hero_actions">
          <a href="/contacto" class="btn btn_primary">Comenzar ahora</a>
          <a href="#services" class="btn btn_outline">Ver servicios</a>
        </div>
      </div>

      <div class="hero_visual" aria-hidden="true">
        <div class="hero_blob">
          <BuildingIcon size={72} stroke={1.4} class="hero_icon" />
          <span class="hero_brand_text">TramiMuni</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section_alt" aria-labelledby="how_title">
    <div class="container">
      <SectionHeader id="how_title" badge="El proceso" title="¿Cómo funcionan nuestros servicios?">
        Nuestros servicios están orientados a facilitarle al contribuyente de la Municipalidad
        de San Carlos la realización de sus trámites sin necesidad de desplazarse a las
        oficinas municipales.
      </SectionHeader>

      <ol class="steps" role="list">
        {steps.map((step, i) => (
          <li>
            <article class="step" aria-labelledby={`step_${i + 1}_title`}>
              <span class="step_number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 id={`step_${i + 1}_title`}>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why us -->
  <section class="section" aria-labelledby="why_title">
    <div class="container why">
      <SectionHeader id="why_title" badge="¿Por qué nosotros?" title="¿Por qué TramiMuni?" align="start">
        TramiMuni nace como una iniciativa de acompañamiento ciudadano para facilitar la gestión
        de trámites municipales, reduciendo errores, traslados innecesarios y tiempos de espera.
      </SectionHeader>

      <ul class="benefits" role="list">
        {benefits.map((benefit) => (
          <li class="benefit">
            <span class="benefit_check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            </span>
            <div>
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section section_alt" id="services" aria-labelledby="services_title">
    <div class="container">
      <SectionHeader id="services_title" badge="Nuestros servicios" title="¿En qué podemos ayudarle?" />
      <ul class="services" role="list">
        {services.map((service) => <li><ServiceCard service={service} /></li>)}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta_title">
    <div class="container">
      <div class="cta">
        <span class="section_badge">¿Listo para comenzar?</span>
        <h2 id="cta_title">Contáctenos y comencemos a trabajar juntos</h2>
        <p>Estamos disponibles para atender su consulta y guiarle en cada paso del proceso.</p>
        <a href="/contacto" class="btn btn_primary">Ir a contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(760px, calc(100dvh - var(--navbar_height)));
    background:
      radial-gradient(40rem 28rem at 78% 45%, color-mix(in srgb, var(--color_primary_light) 18%, transparent), transparent 70%),
      var(--color_bg);
  }

  .hero_grid {
    display: grid;
    gap: var(--spacing_lg);
    align-items: center;
    padding-block: var(--spacing_xl);
  }

  .hero_content {
    display: grid;
    justify-items: center;
    gap: var(--spacing_sm);
    text-align: center;
  }

  .hero_content h1 {
    max-width: 16ch;
  }

  .hero_content p {
    max-width: 52ch;
  }

  .hero_actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing_xs);
    margin-top: var(--spacing_xs);
  }

  .hero_visual {
    display: grid;
    place-items: center;
    order: -1;
  }

  .hero_blob {
    width: clamp(210px, 48vw, 400px);
    aspect-ratio: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    color: #fff;
    background: linear-gradient(140deg, var(--color_primary_light), var(--color_primary) 55%, var(--color_primary_dark));
    border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%;
    box-shadow:
      0 30px 60px -20px color-mix(in srgb, var(--color_primary) 55%, transparent),
      inset 0 2px 0 rgb(255 255 255 / 0.25);
    animation: blob-morph 10s ease-in-out infinite;
  }

  .hero_blob :global(.hero_icon) {
    width: clamp(48px, 9vw, 76px);
    height: auto;
    opacity: 0.9;
  }

  .hero_brand_text {
    font-family: var(--font_display);
    font-size: clamp(1.5rem, 4.5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.18);
  }

  @keyframes blob-morph {
    0%, 100% { border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%; }
    25%      { border-radius: 50% 50% 40% 60% / 60% 40% 55% 45%; }
    50%      { border-radius: 40% 60% 60% 40% / 50% 50% 50% 50%; }
    75%      { border-radius: 55% 45% 45% 55% / 40% 60% 45% 55%; }
  }

  /* ── Steps ────────────────────────────────────────────── */
  .steps {
    display: grid;
    gap: var(--spacing_sm);
  }

  .step {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: var(--spacing_md);
    background: var(--color_bg_card);
    border: 1px solid var(--color_border);
    border-top: 3px solid var(--color_primary);
    border-radius: var(--radius_md);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .step:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow_md);
  }

  .step_number {
    font-family: var(--font_display);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color_primary);
    font-variant-numeric: lining-nums tabular-nums;
  }

  :global([data-theme="dark"]) .step_number {
    color: var(--color_primary_light);
  }

  .step h3 {
    font-size: 1.12rem;
  }

  .step p {
    font-size: 0.95rem;
  }

  /* ── Why ──────────────────────────────────────────── */
  .why {
    display: grid;
    gap: var(--spacing_md);
    align-items: center;
  }

  .why :global(.section_header) {
    margin-bottom: 0;
  }

  .benefits {
    display: grid;
    gap: var(--spacing_sm);
  }

  .benefit {
    display: flex;
    gap: var(--spacing_sm);
    align-items: flex-start;
    padding: var(--spacing_sm) var(--spacing_md);
    background: var(--color_bg_secondary);
    border-radius: var(--radius_md);
  }

  .benefit_check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius_full);
    background: var(--color_primary);
    color: #fff;
  }

  .benefit h3 {
    font-size: 1.08rem;
    margin-bottom: 0.15rem;
  }

  .benefit p {
    font-size: 0.95rem;
  }

  /* ── Services ────────────────────────────────────────── */
  .services {
    display: grid;
    gap: var(--spacing_md);
  }

  /* ── CTA ──────────────────────────────────────────────── */
  .cta {
    display: grid;
    justify-items: center;
    gap: var(--spacing_sm);
    padding: var(--spacing_xl) var(--spacing_md);
    text-align: center;
    border-radius: var(--radius_lg);
    border: 1px solid color-mix(in srgb, var(--color_primary_light) 50%, transparent);
    background:
      radial-gradient(30rem 14rem at 50% 0%, color-mix(in srgb, var(--color_primary_light) 25%, transparent), transparent 70%),
      var(--color_primary_bg);
  }

  .cta h2 {
    max-width: 20ch;
    color: var(--color_primary_dark);
  }

  :global([data-theme="dark"]) .cta h2 {
    color: var(--color_primary_light);
  }

  .cta p {
    max-width: 48ch;
  }

  /* ── Breakpoints ──────────────────────────────────────── */
  @media (min-width: 768px) {
    .hero_grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero_visual {
      order: 0;
    }

    .hero_content {
      justify-items: start;
      text-align: left;
    }

    .hero_actions {
      justify-content: flex-start;
    }

    .steps,
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .steps,
    .services {
      grid-template-columns: repeat(4, 1fr);
    }

    .why {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing_2xl);
    }
  }
</style>
