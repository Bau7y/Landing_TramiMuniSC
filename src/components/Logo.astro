---
import { site } from '../data/site';

interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---
<a href="/" class:list={['logo', `logo_${size}`]} aria-label={`${site.name} - Inicio`}>
  Trami<span>Muni</span>SC
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font_display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color_text);
    flex-shrink: 0;
  }

  .logo span {
    color: var(--color_primary);
  }

  :global([data-theme="dark"]) .logo span {
    color: var(--color_primary_light);
  }

  .logo_md { font-size: 1.35rem; }
  .logo_sm { font-size: 1.15rem; }
</style>
