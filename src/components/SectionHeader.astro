---
interface Props {
  id: string;
  badge: string;
  titulo: string;
  align?: 'center' | 'start';
}
const { id, badge, titulo, align = 'center' } = Astro.props;
---
<header class:list={['section-header', `section-header--${align}`]}>
  <span class="section__badge">{badge}</span>
  <h2 id={id}>{titulo}</h2>
  {Astro.slots.has('default') && <p><slot /></p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: var(--spacing_lg);
  }

  .section-header--center {
    text-align: center;
    justify-items: center;
  }

  .section-header--start {
    justify-items: start;
  }

  .section-header p {
    max-width: 62ch;
  }
</style>
