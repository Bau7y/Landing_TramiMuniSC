---
import Logo from './Logo.astro';
import { obtenerNavegacion } from '../data/navegacion';

const { principal, contacto } = await obtenerNavegacion();
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';

const esActivo = (href: string) =>
  href === '/' ? ruta === '/' : ruta === href || ruta.startsWith(`${href}/`);
---
<header class="navbar" data-navbar>
  <nav class="container navbar__inner" aria-label="Navegación principal">
    <Logo />

    <ul class="navbar__links" role="list">
      {principal.map((enlace) => (
        <li>
          <a
            href={enlace.href}
            class:list={{ active: esActivo(enlace.href) }}
            aria-current={esActivo(enlace.href) ? 'page' : undefined}
          >
            {enlace.etiqueta}
          </a>
        </li>
      ))}
    </ul>

    <div class="navbar__actions">
      <button
        type="button"
        class="btn-icon"
        data-theme-toggle
        aria-label="Activar modo oscuro"
        aria-pressed="false"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <a
        href={contacto.href}
        class:list={['btn btn-primary navbar__cta', { active: esActivo(contacto.href) }]}
        aria-current={esActivo(contacto.href) ? 'page' : undefined}
      >
        {contacto.etiqueta}
      </a>

      <button
        type="button"
        class="btn-icon btn-menu"
        data-menu-toggle
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <nav id="mobile-menu" class="navbar__mobile" aria-label="Menú móvil" data-mobile-menu>
    <ul role="list">
      {[...principal, contacto].map((enlace) => (
        <li>
          <a
            href={enlace.href}
            class:list={{ active: esActivo(enlace.href) }}
            aria-current={esActivo(enlace.href) ? 'page' : undefined}
          >
            {enlace.etiqueta}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const THEME_KEY = 'tramimuni-theme';

  const navbar = document.querySelector<HTMLElement>('[data-navbar]')!;
  const theme_btn = navbar.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const menu_btn = navbar.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobile_menu = navbar.querySelector<HTMLElement>('[data-mobile-menu]')!;

  /* ── Tema ───────────────────────────────────────────── */
  const sincronizarTema = () => {
    const oscuro = document.documentElement.dataset.theme === 'dark';
    theme_btn.setAttribute('aria-pressed', String(oscuro));
    theme_btn.setAttribute('aria-label', oscuro ? 'Activar modo claro' : 'Activar modo oscuro');
  };

  theme_btn.addEventListener('click', () => {
    const destino = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = destino;
    try { localStorage.setItem(THEME_KEY, destino); } catch {}
    sincronizarTema();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let manual: string | null = null;
    try { manual = localStorage.getItem(THEME_KEY); } catch {}
    if (manual) return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    sincronizarTema();
  });

  sincronizarTema();

  /* ── Sombra al hacer scroll ─────────────────────────── */
  const onScroll = () => navbar.classList.toggle('scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ── Menú móvil ─────────────────────────────────────── */
  const setMenu = (abierto: boolean) => {
    mobile_menu.classList.toggle('open', abierto);
    menu_btn.classList.toggle('open', abierto);
    menu_btn.setAttribute('aria-expanded', String(abierto));
    menu_btn.setAttribute('aria-label', abierto ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
  };

  menu_btn.addEventListener('click', () => setMenu(!mobile_menu.classList.contains('open')));
  mobile_menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('click', (e) => {
    if (!navbar.contains(e.target as Node)) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobile_menu.classList.contains('open')) {
      setMenu(false);
      menu_btn.focus();
    }
  });
</script>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    height: var(--navbar_height);
    z-index: var(--z_navbar);
    background: color-mix(in srgb, var(--color_bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color_border);
    transition: background-color var(--transition), box-shadow var(--transition);
  }

  .navbar.scrolled {
    box-shadow: var(--shadow_md);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing_sm);
    height: 100%;
  }

  /* Links desktop */
  .navbar__links {
    display: none;
    align-items: center;
    gap: var(--spacing_md);
  }

  .navbar__links a {
    position: relative;
    padding-block: 0.25rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color_text_muted);
    transition: color var(--transition);
  }

  .navbar__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .navbar__links a:hover,
  .navbar__links a.active {
    color: var(--color_primary);
  }

  .navbar__links a:hover::after,
  .navbar__links a.active::after {
    transform: scaleX(1);
  }

  :global([data-theme="dark"]) .navbar__links a:hover,
  :global([data-theme="dark"]) .navbar__links a.active {
    color: var(--color_primary_light);
  }

  /* Acciones */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing_xs);
  }

  .btn-icon {
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius_full);
    border: 1px solid var(--color_border);
    background: var(--color_bg_card);
    color: var(--color_text);
    transition: background-color var(--transition), border-color var(--transition), transform var(--transition);
  }

  .btn-icon:hover {
    background: var(--color_primary_bg);
    border-color: var(--color_primary_light);
  }

  .btn-icon:active {
    transform: scale(0.94);
  }

  .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-sun { display: block; }
  :global([data-theme="dark"]) .icon-moon { display: none; }

  .navbar__cta {
    display: none;
    padding: 0.55rem 1.2rem;
    font-size: 0.88rem;
  }

  /* Hamburguesa */
  .btn-menu {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-radius: var(--radius_sm);
  }

  .btn-menu span {
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--transition), opacity var(--transition);
  }

  .btn-menu.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .btn-menu.open span:nth-child(2) { opacity: 0; }
  .btn-menu.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menú móvil */
  .navbar__mobile {
    position: fixed;
    inset: var(--navbar_height) 0 auto;
    z-index: var(--z_dropdown);
    padding: var(--spacing_xs) var(--container_px) var(--spacing_sm);
    background: var(--color_bg);
    border-bottom: 1px solid var(--color_border);
    box-shadow: var(--shadow_md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  .navbar__mobile.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .navbar__mobile a {
    display: block;
    padding: 0.8rem 0;
    font-weight: 500;
    color: var(--color_text_muted);
    border-bottom: 1px solid var(--color_border);
    transition: color var(--transition);
  }

  .navbar__mobile li:last-child a {
    border-bottom: none;
  }

  .navbar__mobile a:hover,
  .navbar__mobile a.active {
    color: var(--color_primary);
  }

  @media (min-width: 900px) {
    .navbar__links { display: flex; }
    .navbar__cta { display: inline-flex; }
    .btn-menu,
    .navbar__mobile { display: none; }
  }
</style>
