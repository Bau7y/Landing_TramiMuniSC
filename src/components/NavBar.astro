---
import Logo from './Logo.astro';
import ArrowButton from './ArrowButton.astro';
import { getServices } from '../data/services';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const services = await getServices(lang);
const contactHref = routes.contact[lang];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const mobileLinks = [{ href: routes.home[lang], label: t('nav.home') }, ...services.map((s) => ({ href: s.href, label: s.data.nav_label }))];
---
<div class="scroll_sentinel" data-scroll-sentinel aria-hidden="true"></div>
<header class="navbar" data-navbar>
  <nav class="navbar_pill" aria-label={t('nav.main_label')}>
    <Logo lang={lang} />

    <ul class="navbar_links" role="list">
      {services.map((service) => (
        <li>
          <a href={service.href} class:list={{ active: isActive(service.href) }} aria-current={isActive(service.href) ? 'page' : undefined}>
            {service.data.nav_label}
          </a>
        </li>
      ))}
    </ul>

    <div class="navbar_actions">
      <a href={altHref} class="btn_icon btn_lang" hreflang={otherLang} lang={otherLang} aria-label={t('nav.lang_switch')} data-lang-switch>
        <span aria-hidden="true">{otherLang.toUpperCase()}</span>
      </a>

      <button type="button" class="btn_icon" data-theme-toggle data-label-dark={t('nav.theme_dark')} data-label-light={t('nav.theme_light')} aria-label={t('nav.theme_dark')} aria-pressed="false">
        <svg class="icon_moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="icon_sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <ArrowButton href={contactHref} class="navbar_cta" aria-current={isActive(contactHref) ? 'page' : undefined}>
        {t('nav.contact')}
      </ArrowButton>

      <button type="button" class="btn_icon btn_menu" data-menu-toggle data-label-open={t('nav.open_menu')} data-label-close={t('nav.close_menu')} aria-label={t('nav.open_menu')} aria-expanded="false" aria-controls="mobile_menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div id="mobile_menu" class="navbar_mobile" data-mobile-menu>
    <nav aria-label={t('nav.mobile_label')}>
      <ul role="list">
        {mobileLinks.map((link, i) => (
          <li data-i={i}>
            <a href={link.href} class:list={{ active: path === link.href }} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
      <div class="navbar_mobile_cta" data-i={mobileLinks.length}>
        <ArrowButton href={contactHref}>{t('nav.contact')}</ArrowButton>
      </div>
    </nav>
  </div>
</header>

<script>
  const THEME_KEY = 'tramimuni_theme';

  const navbar = document.querySelector<HTMLElement>('[data-navbar]')!;
  const themeButton = navbar.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const menuButton = navbar.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobileMenu = navbar.querySelector<HTMLElement>('[data-mobile-menu]')!;
  const langSwitch = navbar.querySelector<HTMLAnchorElement>('[data-lang-switch]')!;

  /* ── Theme ───────────────────────────────────────────── */
  const syncTheme = () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    themeButton.setAttribute('aria-pressed', String(isDark));
    themeButton.setAttribute('aria-label', (isDark ? themeButton.dataset.labelLight : themeButton.dataset.labelDark) ?? '');
  };

  themeButton.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    try { localStorage.setItem(THEME_KEY, nextTheme); } catch {}
    syncTheme();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let savedTheme: string | null = null;
    try { savedTheme = localStorage.getItem(THEME_KEY); } catch {}
    if (savedTheme) return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    syncTheme();
  });

  syncTheme();

  /* ── Language: remember the explicit choice ─────────── */
  langSwitch.addEventListener('click', () => {
    try { localStorage.setItem('tramimuni_lang', langSwitch.hreflang); } catch {}
  });

  /* ── Elevated pill after scrolling ───────────────────── */
  // A sentinel at the top of the page: no scroll listener and no geometry
  // reads (window.scrollY), so the browser never has to force a layout.
  const sentinel = document.querySelector<HTMLElement>('[data-scroll-sentinel]')!;
  new IntersectionObserver(([entry]) => navbar.classList.toggle('scrolled', !entry.isIntersecting)).observe(sentinel);

  /* ── Mobile menu ─────────────────────────────────────── */
  // While open, everything outside the header is inert: keyboard and screen
  // reader focus stay in the menu and the navbar controls above it.
  const outside = () => document.querySelectorAll<HTMLElement>('body > :not(header):not(script)');

  const setMenuOpen = (isOpen: boolean) => {
    if (isOpen === mobileMenu.classList.contains('open')) return;
    mobileMenu.classList.toggle('open', isOpen);
    menuButton.classList.toggle('open', isOpen);
    document.documentElement.classList.toggle('menu_open', isOpen);
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', (isOpen ? menuButton.dataset.labelClose : menuButton.dataset.labelOpen) ?? '');
    outside().forEach((el) => el.toggleAttribute('inert', isOpen));
    if (isOpen) mobileMenu.querySelector<HTMLElement>('a')?.focus();
  };

  menuButton.addEventListener('click', () => setMenuOpen(!mobileMenu.classList.contains('open')));
  mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
      setMenuOpen(false);
      menuButton.focus();
    }
  });
  window.matchMedia('(min-width: 1200px)').addEventListener('change', (e) => e.matches && setMenuOpen(false));
</script>

<style>
  /* Leaves the viewport after 12px of scroll (see script) */
  .scroll_sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 12px;
    pointer-events: none;
  }

  .navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z_navbar);
    padding: 16px var(--container_px) 0;
    pointer-events: none;
  }

  /* Floating island */
  .navbar_pill {
    pointer-events: auto;
    position: relative;
    z-index: calc(var(--z_menu) + 1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    max-width: var(--container_max);
    margin-inline: auto;
    padding: 6px 6px 6px 16px;
    border-radius: var(--radius_full);
    background: color-mix(in srgb, var(--color_surface) 82%, transparent);
    border: 1px solid var(--color_border);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    transition: box-shadow var(--duration_base) var(--ease_out), background-color var(--duration_base) var(--ease_out);
  }

  .navbar.scrolled .navbar_pill {
    box-shadow: var(--shadow_md);
  }

  .navbar_links {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar_links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.75rem;
    border-radius: var(--radius_full);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color_muted);
    transition: color var(--transition), background-color var(--transition);
  }

  .navbar_links a:hover {
    color: var(--color_text);
    background: var(--color_row_hover);
  }

  .navbar_links a.active {
    color: var(--color_accent);
    background: var(--color_tint);
  }

  .navbar_actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .btn_icon {
    width: 44px;
    height: 44px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius_full);
    border: 1px solid var(--color_border);
    background: var(--color_surface);
    color: var(--color_text);
    transition: border-color var(--transition), transform var(--duration_fast) var(--ease_spring);
  }

  .btn_icon:hover {
    border-color: var(--color_accent);
  }

  .btn_icon:active {
    transform: scale(0.94);
  }

  .btn_lang {
    font-family: var(--font_mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .icon_sun { display: none; }
  :global([data-theme="dark"]) .icon_sun { display: block; }
  :global([data-theme="dark"]) .icon_moon { display: none; }

  .navbar_actions :global(.navbar_cta) {
    display: none;
    min-height: 44px;
    padding-left: 1.1rem;
    font-size: 0.88rem;
  }

  .navbar_actions :global(.navbar_cta .btn_knob) {
    width: 32px;
    height: 32px;
  }

  /* Hamburger: two lines that morph into an X */
  .btn_menu {
    position: relative;
  }

  .btn_menu span {
    position: absolute;
    left: 50%;
    width: 18px;
    height: 1.5px;
    margin-left: -9px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--duration_base) var(--ease_spring);
  }

  .btn_menu span:nth-child(1) { transform: translateY(-3.5px); }
  .btn_menu span:nth-child(2) { transform: translateY(3.5px); }
  .btn_menu.open span:nth-child(1) { transform: rotate(45deg); }
  .btn_menu.open span:nth-child(2) { transform: rotate(-45deg); }

  /* Full-screen mobile menu with staggered links */
  .navbar_mobile {
    pointer-events: none;
    position: fixed;
    inset: 0;
    z-index: var(--z_menu);
    display: grid;
    align-items: center;
    padding: calc(var(--navbar_offset) + 1rem) calc(var(--container_px) + 0.5rem) 2rem;
    background: color-mix(in srgb, var(--color_canvas) 88%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    overflow-y: auto;
    transition: opacity var(--duration_base) var(--ease_out), visibility var(--duration_base);
  }

  .navbar_mobile.open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  .navbar_mobile ul {
    display: grid;
    gap: 0.25rem;
  }

  .navbar_mobile li,
  .navbar_mobile_cta {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity var(--duration_slow) var(--ease_out),
      transform var(--duration_slow) var(--ease_out);
  }

  .navbar_mobile.open li,
  .navbar_mobile.open .navbar_mobile_cta {
    opacity: 1;
    transform: none;
    transition-delay: calc(80ms + var(--i) * 50ms);
  }

  .navbar_mobile a:not(:global(.btn)) {
    display: block;
    padding: 0.4rem 0;
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color_muted);
    transition: color var(--transition);
  }

  .navbar_mobile a:not(:global(.btn)):hover,
  .navbar_mobile a.active {
    color: var(--color_accent);
  }

  .navbar_mobile_cta {
    margin-top: 2rem;
  }

  :global(html.menu_open) {
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .navbar_actions :global(.navbar_cta) { display: inline-flex; }
  }

  @media (min-width: 1200px) {
    .navbar_links { display: flex; }
    .btn_menu,
    .navbar_mobile { display: none; }
  }
</style>
