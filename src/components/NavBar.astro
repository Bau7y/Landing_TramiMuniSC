---
import Logo from './Logo.astro';
import { getNavigation } from '../data/navigation';

const { main, contact } = await getNavigation();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<header class="navbar" data-navbar>
  <nav class="container navbar_inner" aria-label="Navegación principal">
    <Logo />

    <ul class="navbar_links" role="list">
      {main.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={{ active: isActive(link.href) }}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="navbar_actions">
      <button
        type="button"
        class="btn_icon"
        data-theme-toggle
        aria-label="Activar modo oscuro"
        aria-pressed="false"
      >
        <svg class="icon_moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="icon_sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <a
        href={contact.href}
        class:list={['btn btn_primary navbar_cta', { active: isActive(contact.href) }]}
        aria-current={isActive(contact.href) ? 'page' : undefined}
      >
        {contact.label}
      </a>

      <button
        type="button"
        class="btn_icon btn_menu"
        data-menu-toggle
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile_menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <nav id="mobile_menu" class="navbar_mobile" aria-label="Menú móvil" data-mobile-menu>
    <ul role="list">
      {[...main, contact].map((link) => (
        <li>
          <a
            href={link.href}
            class:list={{ active: isActive(link.href) }}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const THEME_KEY = 'tramimuni_theme';

  const navbar = document.querySelector<HTMLElement>('[data-navbar]')!;
  const themeButton = navbar.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const menuButton = navbar.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobileMenu = navbar.querySelector<HTMLElement>('[data-mobile-menu]')!;

  /* ── Theme ───────────────────────────────────────────── */
  const syncTheme = () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    themeButton.setAttribute('aria-pressed', String(isDark));
    themeButton.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
  };

  themeButton.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    try { localStorage.setItem(THEME_KEY, nextTheme); } catch {}
    syncTheme();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let savedTheme: string | null = null;
    try { savedTheme = localStorage.getItem(THEME_KEY); } catch {}
    if (savedTheme) return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    syncTheme();
  });

  syncTheme();

  /* ── Shadow on scroll ─────────────────────────── */
  const onScroll = () => navbar.classList.toggle('scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ── Mobile menu ─────────────────────────────────────── */
  const setMenuOpen = (isOpen: boolean) => {
    mobileMenu.classList.toggle('open', isOpen);
    menuButton.classList.toggle('open', isOpen);
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
  };

  menuButton.addEventListener('click', () => setMenuOpen(!mobileMenu.classList.contains('open')));
  mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('click', (e) => {
    if (!navbar.contains(e.target as Node)) setMenuOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
      setMenuOpen(false);
      menuButton.focus();
    }
  });
</script>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    height: var(--navbar_height);
    z-index: var(--z_navbar);
    background: color-mix(in srgb, var(--color_bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color_border);
    transition: background-color var(--transition), box-shadow var(--transition);
  }

  .navbar.scrolled {
    box-shadow: var(--shadow_md);
  }

  .navbar_inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing_sm);
    height: 100%;
  }

  /* Desktop links */
  .navbar_links {
    display: none;
    align-items: center;
    gap: var(--spacing_md);
  }

  .navbar_links a {
    position: relative;
    padding-block: 0.25rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color_text_muted);
    transition: color var(--transition);
  }

  .navbar_links a::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .navbar_links a:hover,
  .navbar_links a.active {
    color: var(--color_primary);
  }

  .navbar_links a:hover::after,
  .navbar_links a.active::after {
    transform: scaleX(1);
  }

  :global([data-theme="dark"]) .navbar_links a:hover,
  :global([data-theme="dark"]) .navbar_links a.active {
    color: var(--color_primary_light);
  }

  /* Actions */
  .navbar_actions {
    display: flex;
    align-items: center;
    gap: var(--spacing_xs);
  }

  .btn_icon {
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius_full);
    border: 1px solid var(--color_border);
    background: var(--color_bg_card);
    color: var(--color_text);
    transition: background-color var(--transition), border-color var(--transition), transform var(--transition);
  }

  .btn_icon:hover {
    background: var(--color_primary_bg);
    border-color: var(--color_primary_light);
  }

  .btn_icon:active {
    transform: scale(0.94);
  }

  .icon_sun { display: none; }
  :global([data-theme="dark"]) .icon_sun { display: block; }
  :global([data-theme="dark"]) .icon_moon { display: none; }

  .navbar_cta {
    display: none;
    padding: 0.55rem 1.2rem;
    font-size: 0.88rem;
  }

  /* Hamburger */
  .btn_menu {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-radius: var(--radius_sm);
  }

  .btn_menu span {
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--transition), opacity var(--transition);
  }

  .btn_menu.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .btn_menu.open span:nth-child(2) { opacity: 0; }
  .btn_menu.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .navbar_mobile {
    position: fixed;
    inset: var(--navbar_height) 0 auto;
    z-index: var(--z_dropdown);
    padding: var(--spacing_xs) var(--container_px) var(--spacing_sm);
    background: var(--color_bg);
    border-bottom: 1px solid var(--color_border);
    box-shadow: var(--shadow_md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  .navbar_mobile.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .navbar_mobile a {
    display: block;
    padding: 0.8rem 0;
    font-weight: 500;
    color: var(--color_text_muted);
    border-bottom: 1px solid var(--color_border);
    transition: color var(--transition);
  }

  .navbar_mobile li:last-child a {
    border-bottom: none;
  }

  .navbar_mobile a:hover,
  .navbar_mobile a.active {
    color: var(--color_primary);
  }

  @media (min-width: 900px) {
    .navbar_links { display: flex; }
    .navbar_cta { display: inline-flex; }
    .btn_menu,
    .navbar_mobile { display: none; }
  }
</style>
