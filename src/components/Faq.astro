---
/**
 * FAQ as flip cards: question on the front, answer on the back.
 * Flips on hover (mouse), on keyboard focus, and on tap/Enter (touch and
 * keyboard). Both faces stay in the DOM, so screen readers read question and
 * answer in order. Also prints its FAQPage markup from the same list.
 */
import JsonLd from './JsonLd.astro';
import { faqSchema, type FaqItem } from '../lib/structured_data';

interface Props {
  id: string;
  title: string;
  /** Short call to action on the front face ("Ver respuesta"). */
  hint: string;
  items: FaqItem[];
}
const { id, title, hint, items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby={id}>
    <h2 id={id} data-reveal>{title}</h2>
    <ul class="faq_grid" role="list">
      {items.map((item, i) => (
        <li class="flip_card" data-reveal data-i={i} data-flip tabindex="0">
          <div class="flip_inner">
            <div class="flip_face flip_front">
              <span class="mono flip_number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.q}</h3>
              <span class="flip_hint" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5" /></svg>
                {hint}
              </span>
            </div>
            <div class="flip_face flip_back">
              <p>{item.a}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <JsonLd data={faqSchema(items)} />
  </section>
)}

<script>
  // Tap (touch) and Enter/Space (keyboard) toggle the card; hover is CSS-only.
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((card) => {
    const toggle = () => card.classList.toggle('is_flipped');
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggle();
    });
  });
</script>

<style>
  .faq h2 {
    margin-bottom: 1.5rem;
  }

  .faq_grid {
    display: grid;
    gap: 1rem;
  }

  .flip_card {
    perspective: 1200px;
    cursor: pointer;
    border-radius: var(--radius_lg);
  }

  /* Both faces share one grid cell: the card is as tall as its longest face */
  .flip_inner {
    display: grid;
    min-height: 210px;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease_spring);
  }

  .flip_face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius_lg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip_front {
    background: var(--color_surface);
    border: 1px solid var(--color_border);
  }

  .flip_front h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .flip_number {
    color: var(--color_accent);
  }

  .flip_hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color_muted);
  }

  .flip_back {
    justify-content: center;
    background: var(--color_accent);
    transform: rotateY(180deg);
  }

  .flip_back p {
    color: var(--color_on_accent);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* Flip triggers: hover only where a real pointer can hover */
  @media (hover: hover) {
    .flip_card:hover .flip_inner {
      transform: rotateY(180deg);
    }
  }

  .flip_card:focus-visible .flip_inner,
  .flip_card:global(.is_flipped) .flip_inner {
    transform: rotateY(180deg);
  }

  .flip_card:focus-visible {
    outline: 2px solid var(--color_accent);
    outline-offset: 4px;
  }

  /* Reduced motion: no 3D turn, the answer fades in over the question */
  @media (prefers-reduced-motion: reduce) {
    .flip_inner,
    .flip_card:hover .flip_inner,
    .flip_card:focus-visible .flip_inner,
    .flip_card:global(.is_flipped) .flip_inner {
      transform: none;
    }

    .flip_back {
      transform: none;
      opacity: 0;
      transition: opacity 0.2s linear;
    }

    .flip_card:hover .flip_back,
    .flip_card:focus-visible .flip_back,
    .flip_card:global(.is_flipped) .flip_back {
      opacity: 1;
    }
  }

  @media (min-width: 640px) {
    .faq_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .faq_grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
