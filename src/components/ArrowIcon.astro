---
interface Props {
  size?: number;
  direction?: 'up_right' | 'down';
}
const { size = 16, direction = 'up_right' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {direction === 'down' ? <path d="M12 5v14M6 13l6 6 6-6" /> : <path d="M7 17 17 7M8 7h9v9" />}
</svg>
