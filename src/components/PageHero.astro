---
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  subtitle: string;
  crumb: string;
  eyebrow?: string;
  /** Last content review, shown under the subtitle. */
  updated?: Date;
  /** Intermediate breadcrumb level, e.g. the guides index. */
  parent?: { label: string; href: string };
}
const { lang, title, subtitle, crumb, eyebrow, updated, parent } = Astro.props;
const t = useTranslations(lang);
const updatedText = updated?.toLocaleDateString(lang === 'es' ? 'es-CR' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<section class="page_hero" aria-labelledby="page_title">
  <div class="container page_hero_inner">
    <nav class="breadcrumb" aria-label={t('nav.breadcrumb')} data-reveal>
      <ol role="list">
        <li><a href={routes.home[lang]}>{t('nav.home')}</a></li>
        {parent && <li><a href={parent.href}>{parent.label}</a></li>}
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow" data-reveal data-i="1">{eyebrow}</span>}
    <h1 id="page_title" data-reveal data-i="1">{title}</h1>
    <p data-reveal data-i="2">{subtitle}</p>
    {updated && (
      <p class="page_updated mono" data-reveal data-i="3">
        {t('page.updated')} <time datetime={updated.toISOString().slice(0, 10)}>{updatedText}</time>
      </p>
    )}
  </div>
</section>

<style>
  .page_hero .page_updated {
    font-size: 0.8rem;
    color: var(--color_subtle);
  }

  .page_hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .page_hero_inner {
    display: grid;
    gap: 1rem;
  }

  .page_hero h1 {
    max-width: 18ch;
  }

  .page_hero p {
    max-width: 58ch;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font_mono);
    font-size: 0.75rem;
    color: var(--color_subtle);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.6;
  }

  .breadcrumb a {
    color: var(--color_accent);
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
