---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const { card } = service.data;
const titleId = `service_${service.id}_title`;
---
<article class="service_card" aria-labelledby={titleId}>
  <div class="service_card_img">
    <Image
      src={card.image}
      alt={card.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 280px, (min-width: 768px) 45vw, 92vw"
      format="webp"
      quality={72}
      loading="lazy"
    />
  </div>
  <div class="service_card_body">
    <h3 id={titleId}>{card.title}</h3>
    <p>{card.summary}</p>
    <a href={`/servicios/${service.id}`} class="link_arrow service_card_link">
      Ver detalles <span aria-hidden="true">→</span>
      <span class="sr_only">sobre {card.title}</span>
    </a>
  </div>
</article>

<style>
  .service_card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color_bg_card);
    border: 1px solid var(--color_border);
    border-radius: var(--radius_lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .service_card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow_lg);
    border-color: color-mix(in srgb, var(--color_primary) 35%, var(--color_border));
  }

  .service_card_img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color_primary_bg);
  }

  .service_card_img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .service_card:hover .service_card_img img {
    transform: scale(1.05);
  }

  .service_card_body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--spacing_md);
  }

  .service_card_body h3 {
    font-size: 1.2rem;
  }

  .service_card_body p {
    font-size: 0.95rem;
  }

  .service_card_link {
    margin-top: auto;
    padding-top: var(--spacing_xs);
  }

  /* Makes the whole card clickable without nesting links */
  .service_card_link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service_card:has(.service_card_link:focus-visible) {
    outline: 2px solid var(--color_primary);
    outline-offset: 3px;
  }

  .service_card_link:focus-visible {
    outline: none;
  }
</style>
